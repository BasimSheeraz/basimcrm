# ==============================================================================
# Basim CRM — Environment Configuration
# ==============================================================================

# 1. Supabase PostgreSQL & Auth Credentials
# Find these in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Cryptography & Security Keys
# 32-byte hex string (64 characters) used for AES-256-GCM token encryption
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Secret used to authorize /api/sync cron jobs
# Generate via: openssl rand -base64 32
CRON_SECRET="your-secure-cron-secret-token"

# 3. Google Cloud OAuth 2.0 Credentials (for 3 Personal Gmail Mailboxes)
# Web application credentials from Google Cloud Console (Authorized redirect URI: http://localhost:3000/api/auth/callback)
GOOGLE_CLIENT_ID="123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# 4. App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
